# Copy these names into Vercel -> Project -> Settings -> Environment Variables
# (or a local .env for `vercel dev`). NEVER commit real values.
# See docs/PREMIUM_ENTITLEMENT.md for how to obtain each one.

# Long random string (>= 32 chars) that authorises the admin endpoints.
# Generate with: openssl rand -base64 48
ADMIN_SECRET=

# Upstash Redis REST credentials (use the read-WRITE token, not the read-only one).
# Vercel's Upstash integration may inject these as KV_REST_API_URL / KV_REST_API_TOKEN
# instead — both spellings are accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
